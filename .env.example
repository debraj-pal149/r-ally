ANTHROPIC_API_KEY=
FISH_AUDIO_API_KEY=
ELEVENLABS_API_KEY=
STRAVA_CLIENT_ID=
# Public HTTPS URL of the deployed stravaOAuth Cloud Function (no secret in the app).
STRAVA_OAUTH_PROXY_URL=
# Mixpanel project tokens. Debug builds use the dev token. Release builds use the prod token.
MIXPANEL_DEV_TOKEN=
MIXPANEL_PROD_TOKEN=

# Server-only (never put in the iOS app / Info.plist):
# STRAVA_CLIENT_SECRET=   # firebase functions:secrets:set STRAVA_CLIENT_SECRET
