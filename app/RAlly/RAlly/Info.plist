<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ANTHROPIC_API_KEY</key>
	<string>$(ANTHROPIC_API_KEY)</string>
	<key>FISH_AUDIO_API_KEY</key>
	<string>$(FISH_AUDIO_API_KEY)</string>
	<key>ELEVENLABS_API_KEY</key>
	<string>$(ELEVENLABS_API_KEY)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>r-ally</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.rally.RAlly</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>rally</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>r-ally reads live heart rate from a Bluetooth strap or a watch in broadcast mode.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>r-ally connects to heart-rate straps so encouragement can use live effort.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>r-ally reads heart rate and past workouts (including Nike Run Club runs synced to Apple Health) to understand your effort.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>r-ally saves completed workouts to Apple Health.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>r-ally uses GPS to measure your pace and distance so it can shout at the right moment.</string>
	<key>NSMotionUsageDescription</key>
	<string>r-ally uses motion and cadence to tell when your form starts to fade.</string>
	<key>STRAVA_CLIENT_ID</key>
	<string>$(STRAVA_CLIENT_ID)</string>
	<key>STRAVA_CLIENT_SECRET</key>
	<string>$(STRAVA_CLIENT_SECRET)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>location</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
</dict>
</plist>
